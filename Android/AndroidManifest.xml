<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.motorcycleman.remote" android:versionCode="18" android:versionName="3.1">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The notification a watch shows, to talk to the PC from the watch (Android 13 and newer ask). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Commands by text message: "MM <PIN> ..." texted to this phone, the answer texted back (asked first). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- The phone page over Bluetooth, when the phone and the PC share no Wi-Fi (asked first). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- The app updates itself from the PC; Android asks the user to allow that the first time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 11 and newer hide the phone's speech recognition service unless the app asks for it. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- and its voice, for spoken replies -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application android:label="Motorcycle Man" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="sensorLandscape" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The phone page's "App" button: motorcycleman://<pc-address>:<port>/?token=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="motorcycleman" />
            </intent-filter>
            <!-- Scanned QR codes. Android 12 and newer open these in the browser instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:port="8080" />
            </intent-filter>
        </activity>
        <!-- Share to Motorcycle Man from any app: links, text, photos and files (see ShareActivity). -->
        <activity android:name=".ShareActivity" android:exported="true" android:label="Motorcycle Man"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- The home-screen widget, and the quick-settings tile. -->
        <receiver android:name=".TalkWidget" android:exported="false" android:label="Motorcycle Man">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_talk_info" />
        </receiver>
        <receiver android:name=".WatchNotice" android:exported="false" />
        <receiver android:name=".FindPhone" android:exported="false" />
        <receiver android:name=".SmsCommands" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <!-- Phone alerts on the PC: Android binds it once the user gives notification access. -->
        <service android:name=".NoticeListener" android:exported="true" android:label="Motorcycle Man: phone alerts on the PC"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service android:name=".TalkTile" android:exported="true" android:label="Talk to PC" android:icon="@drawable/ic_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
